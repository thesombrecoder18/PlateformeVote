# Variables d environnement - AUCUNE VALEUR SECRETE ICI
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service role : cote serveur UNIQUEMENT, jamais NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# === Application ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# Sandbox marker - ne jamais changer en production sans gate valide
NEXT_PUBLIC_VOTE_MODE=sandbox_non_production

# === Internationalisation ===
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# === Gmail OAuth (cote serveur UNIQUEMENT) ===
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# === Securite des sessions ===
SESSION_SECRET=

# === Supabase CLI (local dev) ===
# Ne pas committer ces valeurs si elles ne sont pas les valeurs par defaut
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
